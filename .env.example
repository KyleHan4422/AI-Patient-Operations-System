# Copy to .env and fill in. `.env` is gitignored -- never commit secrets.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Host ports. Defaults avoid the usual collisions (:5432 local Postgres,
# :8000 other local stacks). Change if these are taken on your machine.
# ---------------------------------------------------------------------------
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
API_PORT=8001

# ---------------------------------------------------------------------------
# Postgres -- the system of record. Correctness lives here.
# ---------------------------------------------------------------------------
POSTGRES_USER=patient_ops
POSTGRES_PASSWORD=patient_ops
POSTGRES_DB=patient_ops
DATABASE_URL=postgresql://patient_ops:patient_ops@localhost:5433/patient_ops

# ---------------------------------------------------------------------------
# Redis -- the coordination layer. Holds, circuit breaker, idempotency,
# rate limiting and the ARQ queue. Degradable by design.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=dev                      # dev | test | prod  (dev = human-readable logs)
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
HEALTH_PROBE_TIMEOUT_S=1.0       # per-dependency probe budget for /health

# ---------------------------------------------------------------------------
# Clinic -- schedules are stored as local wall-clock times in this zone.
# Slot step, minimum lead time and booking horizon have defaults in config.py.
# ---------------------------------------------------------------------------
CLINIC_TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# Fault injection -- dev/test only; the app refuses to start with this set
# when APP_ENV=prod. Format: target:mode[@attempt], comma-separated, e.g.
#   FAULT_INJECT=book_appointment:timeout@1
#   FAULT_INJECT=book_appointment:timeout_after_write
# ---------------------------------------------------------------------------
FAULT_INJECT=

# ---------------------------------------------------------------------------
# LLM -- not used until Phase 2. Leave blank for Phase 0/1.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
